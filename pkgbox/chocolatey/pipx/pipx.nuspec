<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>pipx</id>
    <version>1.16.7</version>
    <title>pipx</title>
    <authors>pypa</authors>
    <owners>darkn3rd</owners>
    <projectUrl>https://pipx.pypa.io/</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/darkn3rd/script-tut/refs/heads/master/pkgbox/icons/pipx.png</iconUrl>
    <projectSourceUrl>https://github.com/pypa/pipx</projectSourceUrl>
    <packageSourceUrl>https://github.com/darkn3rd/script-tut/tree/master/pkgbox/chocolatey/pipx</packageSourceUrl>
    <docsUrl>https://pipx.pypa.io/</docsUrl>
    <bugTrackerUrl>https://github.com/pypa/pipx/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/pypa/pipx/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <tags>pipx python cli venv</tags>
    <summary>Install and run Python applications in isolated environments</summary>
    <description>pipx installs and runs Python command-line applications in isolated virtual environments, without polluting the global site-packages.

This package downloads the official `pipx.pyz` zipapp release and wraps it with a `pipx` shim that launches it against a Python interpreter already on PATH (`py` or `python`).

Python itself is not installed by this package; install it separately (e.g. `choco install python`) first.</description>
    <releaseNotes>https://github.com/pypa/pipx/releases/tag/1.16.7</releaseNotes>
    <dependencies>
      <dependency id="python3" version="[3.9.0,)" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>

#!/bin/sh
# Runs a BATCH lesson (.cmd) via cmd.exe - Wine's (macOS/Linux) or the
#  real one (Windows, native or via git-bash/MSYS2/Cygwin).
#
# bash can't exec a .cmd file directly (it's not a PE binary or a script
#  with a shebang it understands), so this shells out explicitly instead.
#
# //c, not /c: MSYS2's automatic argument conversion mistakes a lone "/c"
#  for a POSIX drive-letter path and mangles it into "C:\", which drops
#  cmd.exe into an interactive session instead of running the command
#  (confirmed directly) - doubling the slash is the same escape hatch
#  already used for cscript //Nologo in ../wsh.jscript/run and
#  ../wsh.vbscript/run. Confirmed the same //c also works unchanged
#  under Wine's cmd.exe.
#
# Resolved to an absolute path only when Windows' NoDefaultCurrentDirectoryInExePath
#  is actually set - it strips the current directory from the search
#  path cmd.exe uses to resolve a bare filename (confirmed directly:
#  "a00.output.cmd" by itself fails there, ".\a00.output.cmd" works).
#  It's opt-in hardening, off by default, so this only matters on
#  machines where it's been turned on. Wine never enforces it (confirmed),
#  so this whole check is skipped on the Wine side.
#
# cygpath -w only converts something that already looks like a path.
#  NOT narrowed to Cygwin-only - that would assume MSYS2's automatic
#  argument conversion makes this redundant there, which is untested
#  (no Windows/MSYS2/Cygwin box available to check it against). Kept
#  exactly as the original, already-proven script applied it:
#  unconditionally, for every non-Wine case, since only that combination
#  is actually verified.
# Lesson files live under ./scripts/ - prepend that for a bare filename,
#  same convention as ../wsh.jscript/run and ../wsh.vbscript/run. Skipped
#  if the caller already passed an absolute path.
script="$1"; shift
case "$script" in
  /*) ;;
  *) script="scripts/$script" ;;
esac

if [ "$(uname -s)" = "Darwin" ]; then
  wine cmd //c "$script" "$@"
else
  case "$script" in
    /*) ;;
    *)
      if [ -n "${NoDefaultCurrentDirectoryInExePath+x}" ]; then
        script="$(pwd)/$script"
      fi
      ;;
  esac
  cmd //c "$(cygpath -w "$script")" "$@"
fi

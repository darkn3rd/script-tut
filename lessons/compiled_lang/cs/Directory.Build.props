<Project>
  <!-- Auto-imported by MSBuild before Microsoft.Common.props for every
       project under this directory (walks up from target/*.csproj to
       find this) - BaseIntermediateOutputPath has to be set this early
       to take effect at all; setting it inside the .csproj itself (as
       generated by the Makefile) is too late and produces MSB3539
       ("modified after it was used by MSBuild") on every publish. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>

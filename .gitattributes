# Force LF for scripts, regardless of any machine's core.autocrlf setting.
# Many of these start with a #!/usr/bin/env shebang line - a stray \r
# before the newline there can break execution under a POSIX shell.
*.rb      text eol=lf
*.php     text eol=lf
*.pl      text eol=lf
*.py      text eol=lf
*.awk     text eol=lf
*.gawk    text eol=lf
*.tcl     text eol=lf
*.groovy  text eol=lf
*.sh      text eol=lf
*.bash    text eol=lf
*.ksh     text eol=lf
*.csh     text eol=lf
*.ps1     text eol=lf

# GNU Make recipe lines run through sh.exe even on Windows here (see
# compiled_lang/common.mk) - a stray \r in one is the same class of bug
# as a stray \r before a shebang above.
Makefile  text eol=lf
*.mk      text eol=lf

# Markdown/docs/config read fine with either ending, but keep them LF too
# for consistency across contributors' machines.
*.md      text eol=lf
*.json    text eol=lf
*.rake    text eol=lf
Rakefile  text eol=lf

# compiled_lang/ source files - no shebang/direct-execution concern
# (they're always run through their own compiler, never a shell), but
# kept LF for the same "consistency across contributors' machines"
# reasoning as markdown/json above.
*.java    text eol=lf
*.cs      text eol=lf
*.go      text eol=lf
*.rs      text eol=lf
*.cpp     text eol=lf

# Force CRLF for scripts that only ever run through a native Windows
# interpreter (cmd.exe's parser wants CRLF) - pinned explicitly so a
# committer's core.autocrlf setting can't flip these to LF.
*.cmd     text eol=crlf

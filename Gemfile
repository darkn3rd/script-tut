source "https://rubygems.org"

# tomlrb - pure-Ruby, dependency-free TOML parser for scriptbox/scripts'
#  own cmpaths.toml (see its own header comment) - every generate_*.rb
#  script reads it via scriptbox/scripts/cmpaths.rb. Deliberately not
#  wrapped in `bundle exec` anywhere - these scripts are plain
#  `ruby foo.rb ...` invocations, same as always; run `bundle install`
#  once so `require "tomlrb"` resolves.
gem "tomlrb"

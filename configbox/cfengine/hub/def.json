{
  "vars": {
    "lessons": {
      "user": "vagrant",
      "common_steps": [
        {
          "type": "apt",
          "name": [
            "curl",
            "git",
            "make",
            "wget",
            "gnupg2"
          ]
        },
        {
          "type": "sysctl",
          "name": [
            "net.ipv6.conf.all.disable_ipv6=1",
            "net.ipv6.conf.default.disable_ipv6=1"
          ]
        },
        {
          "type": "noop",
          "name": "zsh_baseline",
          "order": 1
        },
        {
          "type": "script",
          "name": "ubuntu22_sdkman",
          "cmd": "if [ ! -d \"$HOME/.sdkman\" ]; then\n  curl -s \"https://get.sdkman.io\" | bash\n  sed -i 's/sdkman_auto_answer=false/sdkman_auto_answer=true/' \"$HOME/.sdkman/etc/config\"\nfi\nsource \"$HOME/.sdkman/bin/sdkman-init.sh\"\n"
        }
      ],
      "gates": {
        "gen_scripts": true,
        "shell_scripts": true,
        "compiled_lang": true,
        "win_scripts": true
      },
      "areas": {
        "gen_scripts": {
          "steps": [
            {
              "type": "apt",
              "name": [
                "autoconf",
                "bison",
                "build-essential",
                "libbz2-dev",
                "libdb-dev",
                "libffi-dev",
                "libgdbm6",
                "libgdbm-dev",
                "liblzma-dev",
                "libncurses5-dev",
                "libncursesw5-dev",
                "libreadline-dev",
                "libsqlite3-dev",
                "libssl-dev",
                "libxml2-dev",
                "libxmlsec1-dev",
                "libyaml-dev",
                "llvm",
                "tk-dev",
                "xz-utils",
                "zlib1g-dev",
                "gawk",
                "php8.1-cli"
              ]
            },
            {
              "type": "script",
              "name": "ubuntu22_rvm",
              "cmd": "mkdir -p ~/.gnupg\nchmod 700 ~/.gnupg\necho 'disable-ipv6' >> ~/.gnupg/dirmngr.conf\ngpgconf --kill dirmngr\ngpg2 \\\n  --keyserver hkps://keyserver.ubuntu.com \\\n  --recv-keys \\\n  409B6B1796C275462A1703113804BB82D39DC0E3 \\\n  7D2BAF1CF37B13E2069D6956105BD0E739499BDB\ncurl -sSL https://get.rvm.io | bash -s -- --branch master --ignore-dotfiles\nexport PATH=\"$PATH:$HOME/.rvm/bin\"\nsource \"$HOME/.rvm/scripts/rvm\"\n"
            },
            {
              "type": "script",
              "name": "ubuntu22_cpan_local_setup",
              "cmd": "PERL_MM_USE_DEFAULT=1 PERL_MM_OPT=\"INSTALL_BASE=$HOME/perl5\" cpan local::lib\neval \"$(perl -I$HOME/perl5/lib/perl5 -Mlocal::lib=$HOME/perl5)\"\nexport PATH=$HOME/perl5/bin:$PATH\n"
            },
            {
              "type": "cpan",
              "name": "App::cpanminus"
            },
            {
              "type": "cpanm",
              "name": "Switch"
            },
            {
              "type": "cpanm",
              "name": "HTTP::Tiny"
            },
            {
              "type": "sdkman",
              "name": "groovy 5.1.0",
              "cmd": "sdk default groovy 5.1.0"
            },
            {
              "type": "rvm",
              "name": "4.0.6",
              "cmd": "rvm use 4.0.6 --default"
            }
          ]
        },
        "shell_scripts": {
          "steps": [
            {
              "type": "apt",
              "name": [
                "tcsh",
                "ksh93u+m",
                "zsh"
              ]
            }
          ]
        },
        "compiled_lang": {
          "steps": [
            {
              "type": "apt",
              "name": [
                "openjdk-17-jdk",
                "curl",
                "build-essential"
              ]
            },
            {
              "type": "apt",
              "name": [
                "dotnet-sdk-10.0"
              ],
              "apt_repository": "ppa:dotnet/backports"
            },
            {
              "type": "apt",
              "name": [
                "golang-go"
              ],
              "apt_repository": "ppa:longsleep/golang-backports"
            },
            {
              "type": "script",
              "name": "ubuntu22_rust",
              "cmd": "if [ ! -d \"$HOME/.cargo\" ]; then\n  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \\\n    | sh -s -- -y --profile minimal --no-modify-path\nfi\nmkdir -p \"$HOME/.config/powershell\"\nsource \"$HOME/.cargo/env\"\n"
            },
            {
              "type": "file",
              "name": "ubuntu22_rust_ps1",
              "dest": "$HOME/.cargo/env.ps1",
              "content": "# rustup shell setup\n# affix colons on either side of $env:PATH to simplify matching\nif (\":${env:PATH}:\" -notlike \"*:$HOME/.cargo/bin:*\") {\n    # Prepending path in case a system-installed rustc needs to be overridden\n    $env:PATH = \"$HOME/.cargo/bin:$env:PATH\"\n}\n"
            }
          ]
        },
        "win_scripts": {
          "steps": [
            {
              "type": "apt",
              "name": [
                "powershell"
              ],
              "add_apt_repo": {
                "name": "microsoft-prod",
                "key_url": "https://packages.microsoft.com/keys/microsoft.asc",
                "repo_uri": "https://packages.microsoft.com/ubuntu/22.04/prod",
                "distro_string": "jammy main"
              }
            }
          ]
        }
      },
      "appends": {
        "/home/vagrant/.zshrc": [
          "autoload -Uz promptinit",
          "promptinit",
          "prompt adam1",
          "setopt histignorealldups sharehistory",
          "bindkey -e",
          "HISTSIZE=1000",
          "SAVEHIST=1000",
          "HISTFILE=~/.zsh_history",
          "autoload -Uz compinit",
          "compinit",
          "zstyle ':completion:*' auto-description 'specify: %d'",
          "zstyle ':completion:*' completer _expand _complete _correct _approximate",
          "zstyle ':completion:*' format 'Completing %d'",
          "zstyle ':completion:*' group-name ''",
          "zstyle ':completion:*' menu select=2",
          "eval \"$(dircolors -b)\"",
          "zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}",
          "zstyle ':completion:*' list-colors ''",
          "zstyle ':completion:*' list-prompt %SAt %p: Hit TAB for more, or the character to insert%s",
          "zstyle ':completion:*' matcher-list '' 'm:{a-z}={A-Z}' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=* l:|=*'",
          "zstyle ':completion:*' menu select=long",
          "zstyle ':completion:*' select-prompt %SScrolling active: current selection at %p%s",
          "zstyle ':completion:*' use-compctl false",
          "zstyle ':completion:*' verbose true",
          "zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'",
          "zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'",
          "[[ -s \"$HOME/.sdkman/bin/sdkman-init.sh\" ]] && source \"$HOME/.sdkman/bin/sdkman-init.sh\"",
          "eval \"$(perl -I$HOME/perl5/lib/perl5 -Mlocal::lib=$HOME/perl5)\"",
          "export PATH=$HOME/perl5/bin:$PATH",
          "export GOPATH=$(go env GOPATH)",
          "export PATH=$GOPATH/bin:$PATH",
          "source \"$HOME/.cargo/env\""
        ],
        "/home/vagrant/.bashrc": [
          "[[ -s \"$HOME/.sdkman/bin/sdkman-init.sh\" ]] && source \"$HOME/.sdkman/bin/sdkman-init.sh\"",
          "eval \"$(perl -I$HOME/perl5/lib/perl5 -Mlocal::lib=$HOME/perl5)\"",
          "export PATH=$HOME/perl5/bin:$PATH",
          "export GOPATH=$(go env GOPATH)",
          "export PATH=$GOPATH/bin:$PATH",
          "source \"$HOME/.cargo/env\""
        ],
        "/home/vagrant/.config/powershell/Microsoft.PowerShell_profile.ps1": [
          ". \"$HOME/.cargo/env.ps1\""
        ]
      }
    }
  }
}

# lessons.cf
#
# Delivery-agnostic: `def.lessons` is a CFEngine **augments** variable -
#  see def.json next to whichever tree's own promises.cf ran this. Both
#  the standalone tree (reading its own local def.json directly) and the
#  hub tree (reading a def.json distributed as part of this same policy
#  set) land here the same way; this bundle never knows or cares which
#  one is running it.
#
# Area gates (def.lessons[gates][<area>], all default true) skip an area
#  entirely without touching this bundle or any area bundle itself.
bundle agent lessons
{
  vars:
      "user" string => "$(def.lessons[user])";
      "home" string => "/home/$(user)";

      "common_i" slist => getindices("def.lessons[common_steps]");
      "common_step" data => mergedata("{}", "def.lessons[common_steps][$(common_i)]");

  classes:
      "gen_scripts_enabled"   expression => strcmp("$(def.lessons[gates][gen_scripts])", "true");
      "shell_scripts_enabled" expression => strcmp("$(def.lessons[gates][shell_scripts])", "true");
      "compiled_lang_enabled" expression => strcmp("$(def.lessons[gates][compiled_lang])", "true");
      "win_scripts_enabled"   expression => strcmp("$(def.lessons[gates][win_scripts])", "true");

  commands:
    debian::
      "/usr/bin/apt-get update"
        unless => returnszero("/bin/sh -c \"find /var/cache/apt/pkgcache.bin -newer /etc/apt/sources.list 2>/dev/null | grep -q .\"", "useshell");

  methods:
      # 'common' - steps that live directly on the manifest's own
      #  lessons.packages, not nested under any one of the four gated
      #  areas below - always applied, ungated.
      "lessons common $(common_i)"
        usebundle => lessons_install_step("@(common_step)", "$(user)", "$(home)");

      "gen_scripts"
        usebundle => lessons_gen_scripts("$(user)", "$(home)"),
        if => "gen_scripts_enabled";

      "shell_scripts"
        usebundle => lessons_shell_scripts("$(user)", "$(home)"),
        if => "shell_scripts_enabled";

      "compiled_lang"
        usebundle => lessons_compiled_lang("$(user)", "$(home)"),
        if => "compiled_lang_enabled";

      "win_scripts"
        usebundle => lessons_win_scripts("$(user)", "$(home)"),
        if => "win_scripts_enabled";
}

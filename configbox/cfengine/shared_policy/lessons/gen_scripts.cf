# gen_scripts.cf - see lessons.cf's own header. One step per
#  def.lessons[areas][gen_scripts][steps] entry, applied through
#  install_step.cf's shared dispatcher - which does its own path-based
#  lookup internally (see its own header comment), so this bundle only
#  ever needs to hand it the path, never the step data itself.
bundle agent lessons_gen_scripts(user, home)
{
  vars:
      "i" slist => getindices("def.lessons[areas][gen_scripts][steps]");

  methods:
      "gen_scripts $(i)"
        usebundle => lessons_install_step("def.lessons[areas][gen_scripts][steps][$(i)]", "$(user)", "$(home)");
}

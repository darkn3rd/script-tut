# compiled_lang.cf - see lessons.cf's own header. One step per
#  def.lessons[areas][compiled_lang][steps] entry, applied through
#  install_step.cf's shared dispatcher - which does its own path-based
#  lookup internally (see its own header comment), so this bundle only
#  ever needs to hand it the path, never the step data itself.
bundle agent lessons_compiled_lang(user, home)
{
  vars:
      "i" slist => getindices("def.lessons[areas][compiled_lang][steps]");

  methods:
      "compiled_lang $(i)"
        usebundle => lessons_install_step("def.lessons[areas][compiled_lang][steps][$(i)]", "$(user)", "$(home)");
}

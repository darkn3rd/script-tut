source 'https://supermarket.chef.io'
metadata

# scriptbox/sdkman - sibling cookbooks (../scriptbox, ../sdkman), not
#  real dependencies of lessons itself - vendored here anyway so a
#  single `berks vendor` from this one Berksfile populates
#  .berks-vendor/ with every cookbook the Vagrantfile's own run_list
#  (or, for sdkman, a real dependents' own metadata.rb) needs, rather
#  than requiring a separate `berks vendor` invocation per cookbook.
cookbook 'scriptbox', path: '../scriptbox'
cookbook 'sdkman', path: '../sdkman'

# chocolatey/asdf ARE real dependencies (see ../lessons's own
#  metadata.rb) - pinned to these local paths so Berkshelf resolves them
#  here instead of fetching Supermarket's own stale cookbooks of the
#  same name (asdf-chef/asdf in particular predates asdf's own 0.16.0
#  rewrite and doesn't work against a modern asdf - see ../asdf/
#  README.md).
cookbook 'chocolatey', path: '../chocolatey'
cookbook 'asdf', path: '../asdf'

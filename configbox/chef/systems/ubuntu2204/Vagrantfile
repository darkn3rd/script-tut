SCRIPT_TUT_PATH="../../../../.."
DISABLE_IPV6_SCRIPT = <<-SHELL
  sudo tee /etc/sysctl.d/99-disable-ipv6.conf << 'EOF'
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1
EOF
  sudo sysctl --system
SHELL

Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"
  config.vm.box_version = "4.3.12"
  config.vm.hostname = "chef-node-01.test"
  config.vm.synced_folder "#{SCRIPT_TUT_PATH}", "/var/script-tut"

  #config.vm.provision "shell", inline: DISABLE_IPV6_SCRIPT

  # Workaround for https://github.com/hashicorp/vagrant/issues/12587
  config.vm.provision "shell", inline: 'ln -sf cinc /opt/chef'
  
  config.vm.provision "chef_zero" do |chef|
    chef.product = "cinc"
    chef.omnibus_url = "https://omnitruck.cinc.sh/install.sh"
    chef.binary_path = "/opt/cinc/bin"
    chef.version = "19"

    # .berks-vendor/, not cookbooks/ - berks vendor output (lessons +
    #  its own Supermarket dependencies, plus the sibling scriptbox
    #  cookbook - see cookbooks/lessons/Berksfile), gitignored,
    #  regenerated on demand with `berks vendor` from within
    #  cookbooks/lessons - never hand-edited, and never the
    #  hand-authored cookbooks/ tree itself.
    chef.cookbooks_path = "../../.berks-vendor"
    chef.data_bags_path = "../../data_bags"
    chef.nodes_path = "../../nodes"
    # lessons first, always - scriptbox's own gem update/ratatui_ruby
    #  gem install need ruby (via rbenv) already on PATH, which only
    #  lessons::gen_scripts actually installs - see scriptbox's own
    #  recipes/default.rb comment on why it has no apt_update of its
    #  own either, same reasoning.
    chef.add_recipe "lessons"
    chef.add_recipe "scriptbox"
    chef.log_level = "debug"

    # Area gates default true (see ../../cookbooks/lessons/attributes/
    #  default.rb) - override here per node, e.g. chef.json = {
    #  "lessons" => { "win_scripts" => false } }, rather than editing
    #  the cookbook itself.
    chef.json = {
      "lessons" => {
        "platform" => "ubuntu22"
      },
      "scriptbox" => {
        "platform" => "ubuntu22"
      }
    }
  end
end


# file_client: local - no master involved at all; a minion started
#  this way (salt-call --local) applies straight against its own local
#  file_roots/pillar_roots below instead of asking a master for them.
file_client: local

file_roots:
  base:
    - /srv/salt
    - /srv/salt-shared
    - /srv/salt-formulas

pillar_roots:
  base:
    - /srv/pillar

id: ubuntu22

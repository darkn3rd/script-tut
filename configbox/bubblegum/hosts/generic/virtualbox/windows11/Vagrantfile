SCRIPT_TUT_PATH="../../../../../.."

Vagrant.configure("2") do |config|
  config.vm.box = "gusztavvargadr/windows-11"
  config.vm.box_version = "2607.1.0"

  config.vm.synced_folder "#{SCRIPT_TUT_PATH}", "C:/script-tut"

  config.vm.provision "shell",
    name: "windows",
    path: "#{SCRIPT_TUT_PATH}/scriptbox/generated/windows_install.ps1",
    privileged: true

  config.vm.provision "shell", name: "msys2", inline: <<-'SHELL'
    $env:MSYSTEM = "UCRT64"
    # This box image (gusztavvargadr/windows-11) injects HOME=%USERPROFILE%
    # as a process-level env var on every session (confirmed directly -
    # present in both cmd.exe and PowerShell, but absent from both the User
    # and Machine registry scopes, so it isn't a normal persisted env var -
    # something in the box's own build/session-init sets it fresh each
    # time). Bash honors an already-set HOME without ever consulting
    # Cygwin/MSYS2's own user database, so it never gets the chance to
    # compute its real default (/home/vagrant, confirmed against
    # nsswitch.conf's db_home: cygwin desc). Clearing it here - not
    # replacing it with a guessed value - lets MSYS2 fall through to that
    # real default itself, the same as it already does on the host.
    Remove-Item Env:\HOME -ErrorAction SilentlyContinue
    & "C:\tools\msys64\usr\bin\bash.exe" `
        -lc "/c/script-tut/scriptbox/generated/msys2_install.sh"
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
  SHELL

  config.vm.provision "shell", name: "cygwin", inline: <<-'SHELL'
    # See the msys2 provisioner's own comment - same fix, same reason.
    Remove-Item Env:\HOME -ErrorAction SilentlyContinue
    & "C:\tools\cygwin\bin\bash.exe" `
        -lc "/cygdrive/c/script-tut/scriptbox/generated/cygwin_install.sh"
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
  SHELL
end

HOST_REPO_PATH = File.realpath("../../../../..", __dir__)

Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"
  config.vm.box_version = "4.3.12"
  config.vm.hostname = "puppet-site-node-01.test"
  config.vm.synced_folder "#{HOST_REPO_PATH}", "/var/script-tut"

  config.vm.provision "bootstrap",
    type: "shell",
    path: "../../../scripts/ubuntu22_openvox8_bootstrap.sh"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = 4096
    vb.cpus = 4

    # Instruct Virtualbox to use HyperV para-virtualization instead of 
    # guessing that reults in hangs or slowness. 
    vb.customize ["modifyvm", :id, "--paravirtprovider", "hyperv"]
  end

  # site manifest classifier (manifests/nodes/platform_type.pp)
  #  Site Manifest (manifests/nodes/platform_type.pp) is generated by
  #  scriptbox/scripts/generate_puppet.rb --classifier site
  config.vm.provision "apply", type: "puppet" do |puppet|
    puppet.binary_path    = "/opt/puppetlabs/bin"
    puppet.manifests_path = "../../manifests/nodes"
    puppet.manifest_file  = "ubuntu22.pp"
    puppet.module_path    = ["../../../shared_modules", "../../../.forge-vendor"]
    puppet.options        = "--verbose --debug --certname=ubuntu22"
  end
end

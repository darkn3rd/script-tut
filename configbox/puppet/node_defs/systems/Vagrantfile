SCRIPT_TUT_PATH = "../../../.."

# puppet-agent isn't on generic/ubuntu2204 - the puppet_apply provisioner
#  requires it already present in the guest, it does not install Puppet
#  itself (see https://developer.hashicorp.com/vagrant/docs/provisioning/
#  puppet_apply). Idempotent - skips straight to exit 0 on a re-provision.
INSTALL_PUPPET = <<-SHELL
  test -x /opt/puppetlabs/bin/puppet && exit 0
  curl -sL https://apt.puppet.com/puppet8-release-jammy.deb -o /tmp/puppet8-release.deb
  dpkg -i /tmp/puppet8-release.deb
  apt-get update
  apt-get install -y puppet-agent
SHELL

Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"
  config.vm.box_version = "4.3.12"
  config.vm.hostname = "puppet-site-node-01.test"
  config.vm.synced_folder "#{SCRIPT_TUT_PATH}", "/var/script-tut"

  config.vm.provision "shell", inline: INSTALL_PUPPET

  # site manifest classifier - see ../../README.md's own "Configbox
  #  Configuration Items" table. manifests_path/manifest_file point
  #  straight at the GENERATED ../manifests/nodes/ubuntu22.pp (see
  #  scriptbox/scripts/generate_puppet.rb --classifier site) - not
  #  ../manifests/site.pp's own `node default { fail(...) }` fallback,
  #  which exists for ../environment.conf's own directory-environment
  #  manifest= glob (a real multi-node deployment), a different way of
  #  consuming this same tree than this single-box Vagrantfile. Only
  #  ubuntu22 has a generated node block today, so pointing directly at
  #  it (rather than relying on Puppet's own manifest-directory glob
  #  loading, whose exact recursion behavior isn't worth depending on
  #  here) is both simplest and correct. --certname=ubuntu22 - the
  #  generated file's own `node 'ubuntu22' { ... }` block matches
  #  against certname, which puppet apply otherwise defaults to this
  #  box's real hostname (puppet-site-node-01.test) - wouldn't match.
  config.vm.provision "puppet" do |puppet|
    puppet.binary_path    = "/opt/puppetlabs/bin"
    puppet.manifests_path = "../manifests/nodes"
    puppet.manifest_file  = "ubuntu22.pp"
    puppet.module_path    = ["../../shared_modules", "../../.forge-vendor"]
    puppet.options         = "--verbose --debug --certname=ubuntu22"
  end
end

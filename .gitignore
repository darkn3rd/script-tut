.DS_Store
'~$script_tracker.xlsx'
.vagrant

# Python bytecode cache - Salt's own Jinja/loader machinery imports
# configbox/salt/dynamic/roster_modules/lessons_dynamic.py the same way
# any Python module gets imported, leaving one of these behind.
__pycache__/
*.pyc

# lessons/compiled_lang/*/bin/ holds the final, promoted build output;
# target/ holds intermediate build artifacts (obj files, generated
# project files, ...) on the way there (see
# lessons/compiled_lang/README.md) - `make clean` in the language
# directory empties both. .gitkeep keeps each otherwise-empty directory
# itself tracked.
lessons/compiled_lang/*/bin/*
!lessons/compiled_lang/*/bin/.gitkeep
lessons/compiled_lang/*/target/*
!lessons/compiled_lang/*/target/.gitkeep
*.out

# scriptbox/generated/ holds gen_installer.rb's output (<platform>_install.sh),
# regenerated on demand from config/*.yml - see scriptbox/generated/README.md.
scriptbox/generated/*
!scriptbox/generated/README.md

# configbox/chef/.berks-vendor/ holds `berks vendor` output for
# configbox/chef/cookbooks/lessons's own Berksfile - third-party
# Supermarket cookbooks (pyenv, ruby_rbenv, perl - see lessons's own
# metadata.rb), fetched on demand, not part of this repo's own source.
configbox/chef/.berks-vendor/
configbox/chef/nodes

# Locally built Chocolatey packages; regenerate with `choco pack`.
pkgbox/chocolatey/*/vendor/

# pkgbox
pkgbox/chocolatey/*/vendor/*
!pkgbox/chocolatey/*/vendor/.gitkeep

# configbox/ansible/provision/.galaxy-vendor/ holds `ansible-galaxy
# install -r requirements.yml` output (third-party roles/collections -
# diodonfrost.act, community.general, ...), fetched on demand, not part
# of this repo's own source - same reasoning as .berks-vendor/ above.
# .gitkeep keeps the otherwise-empty directory itself tracked.
configbox/ansible/provision/.galaxy-vendor/*
!configbox/ansible/provision/.galaxy-vendor/.gitkeep

# configbox/puppet/.forge-vendor/ holds a Puppet Forge fetch (`puppet
# module install`, r10k, or a plain forgeapi.puppet.com download) for
# configbox/puppet/shared_modules/lessons's own metadata.json dependency -
# puppetlabs-stdlib (ensure_packages/ensure_resource/any2array/dirname/
# file_line) - fetched on demand, not part of this repo's own source,
# same reasoning as .berks-vendor/ and .galaxy-vendor/ above.
configbox/puppet/.forge-vendor/*
!configbox/puppet/.forge-vendor/.gitkeep

# configbox/salt/.formula-vendor/ holds a saltstack-formulas fetch
# (e.g. `git clone --depth 1 https://github.com/saltstack-formulas/
# golang-formula` then keep just its own golang/ subtree) - see
# configbox/salt/README.md's own "Vendoring Formulas" section. Fetched
# on demand, not part of this repo's own source, same reasoning as
# .berks-vendor/, .galaxy-vendor/, and .forge-vendor/ above.
configbox/salt/.formula-vendor/*
!configbox/salt/.formula-vendor/.gitkeep

# Locally built Debian packages and their staged binaries; regenerate
# with `make` (pkgbox/deb) / `update.sh` per package.
pkgbox/deb/*/vendor/*
!pkgbox/deb/*/vendor/.gitkeep

# reprepro's own output (pkgbox/deb/apt-repo) - regenerate with
# publish.sh; published by pushing it to gh-pages, never committed here.
# public.asc is NOT here - it's stable public identity material (like
# LICENSE), tracked in the repo rather than treated as build output.
pkgbox/deb/apt-repo/db/
pkgbox/deb/apt-repo/dists/
pkgbox/deb/apt-repo/pool/
pkgbox/deb/apt-repo/logs/

# integration_test.rb's own actual/ - what really happened last run,
# regenerated every run. expected/ is the committed test oracle, kept.
scriptbox/scripts/test/integration/actual/
